@page "/plan/{AppName}/{Environment}"
@using Deskribe.Core
@using Deskribe.Web.Services
@using Deskribe.Sdk.Models
@using System.Text.Json
@inject DeskribeUiService UiService
@rendermode InteractiveServer

<PageTitle>Plan: @AppName (@Environment) - Deskribe</PageTitle>

<Deskribe.Web.Components.Shared.ConfirmDialog
    IsVisible="@showApplyConfirm"
    Title="Confirm Apply"
    Message='@($"This will provision infrastructure and deploy {AppName} to {Environment}. Continue?")'
    ConfirmText="Apply"
    ButtonClass="btn-success"
    IsProcessing="@isApplying"
    OnConfirm="DoApply"
    OnCancel="() => showApplyConfirm = false" />

<Deskribe.Web.Components.Shared.ConfirmDialog
    IsVisible="@showDestroyConfirm"
    Title="Confirm Destroy"
    Message='@($"This will DESTROY the workloads and infrastructure of {AppName} in {Environment}. This cannot be undone. Continue?")'
    ConfirmText="Destroy"
    ButtonClass="btn-danger"
    IsProcessing="@isDestroying"
    OnConfirm="DoDestroy"
    OnCancel="() => showDestroyConfirm = false" />

<div class="page-header">
    <div>
        <h1>@AppName</h1>
        <div class="flex items-center gap-2 mt-2">
            @if (appInfo != null)
            {
                @foreach (var env in appInfo.Environments)
                {
                    <a href="plan/@AppName/@env"
                       class="env-pill @env @(env == Environment ? "active" : "")"
                       style="text-decoration: none; cursor: pointer;">
                        @env
                    </a>
                }
            }
            @{
                var state = UiService.StateStore.GetState(AppName, Environment);
            }
            <span class="badge @GetStatusBadgeClass(state.Status)">
                <span class="status-dot @GetStatusDotClass(state.Status)"></span> @state.Status
            </span>
        </div>
    </div>
    <div style="display: flex; gap: 8px; align-items: flex-end;">
        <div style="display: flex; flex-direction: column; gap: 4px;">
            <label style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">Images (name=image per line)</label>
            <textarea @bind="imagesText" rows="2" placeholder="registry/app:tag"
                      style="background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-primary); padding: 6px 10px; border-radius: 6px; font-size: 13px; font-family: monospace; width: 280px;"></textarea>
        </div>
        <button class="btn btn-primary" @onclick="GeneratePlan" disabled="@isLoading">
            @if (isLoading) { <span class="spinner"></span> } Plan
        </button>
        <button class="btn btn-success" @onclick="() => showApplyConfirm = true" disabled="@(!UiService.MutationsEnabled || plan == null || isApplying)">
            @if (isApplying) { <span class="spinner"></span> } Apply
        </button>
        <button class="btn btn-danger" @onclick="() => showDestroyConfirm = true" disabled="@(!UiService.MutationsEnabled || isDestroying)">
            @if (isDestroying) { <span class="spinner"></span> } Destroy
        </button>
    </div>
</div>

@if (!UiService.MutationsEnabled)
{
    <div style="background: #e0f2fe; border: 1px solid #38bdf8; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; color: #075985;">
        <strong>Read-only.</strong> @DeskribeUiService.ReadOnlyReason
    </div>
}

@if (errorMessage != null)
{
    <div class="toast error" style="margin-bottom: 16px;">@errorMessage</div>
}
@if (validationErrors.Count > 0)
{
    <div class="toast error" style="margin-bottom: 16px;">
        <strong style="display: block; margin-bottom: 4px;">Validation failed</strong>
        <ul style="margin: 0; padding-left: 20px;">
            @foreach (var error in validationErrors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}
@if (successMessage != null)
{
    <div class="toast success" style="margin-bottom: 16px;">@successMessage</div>
}
@if (warnings.Count > 0)
{
    <div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; color: #92400e;">
        <strong style="display: block; margin-bottom: 4px;">Warnings</strong>
        <ul style="margin: 0; padding-left: 20px;">
            @foreach (var warning in warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

<div class="card" style="margin-bottom: 16px;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <h3>Deployment status</h3>
        <button class="btn btn-outline" style="font-size: 12px;" @onclick="LoadStatus" disabled="@isStatusLoading">
            @if (isStatusLoading) { <span class="spinner"></span> } Refresh
        </button>
    </div>
    <div class="card-body">
        @if (statusResult == null)
        {
            <span class="text-muted">Checking...</span>
        }
        else if (statusResult.Error != null)
        {
            <span class="text-muted">Status unavailable: @statusResult.Error</span>
        }
        else if (statusResult.Status is not { Exists: true } status || status.Workloads.Count == 0)
        {
            <span class="text-muted">Nothing is deployed (namespace @statusResult.Status?.Namespace).</span>
        }
        else
        {
            <div class="text-muted" style="margin-bottom: 8px;">Namespace <code>@status.Namespace</code></div>
            <table class="resource-table">
                <thead><tr><th>Workload</th><th>Image</th><th>Ready</th></tr></thead>
                <tbody>
                    @foreach (var w in status.Workloads)
                    {
                        <tr>
                            <td style="font-weight: 600;">@w.Name</td>
                            <td style="font-family: monospace; font-size: 12px;">@(w.Image ?? "—")</td>
                            <td>
                                <span class="badge @(w.Ready ? "badge-healthy" : "badge-error")">@w.ReadyReplicas/@w.DesiredReplicas</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="tab-nav">
    <button class="@(activeTab == "plan" ? "active" : "")" @onclick='() => activeTab = "plan"'>Plan</button>
    <button class="@(activeTab == "resources" ? "active" : "")" @onclick='() => activeTab = "resources"'>Resources</button>
    <button class="@(activeTab == "workload" ? "active" : "")" @onclick='() => activeTab = "workload"'>Workloads</button>
    <button class="@(activeTab == "bindings" ? "active" : "")" @onclick='() => activeTab = "bindings"'>Bindings</button>
</div>

@if (plan == null && !isLoading)
{
    <div style="text-align: center; padding: 60px; color: var(--text-muted);">
        <div style="font-size: 48px; margin-bottom: 16px;">&#9881;</div>
        <p>Click <strong>Plan</strong> to generate an execution plan for <strong>@AppName</strong> in <strong>@Environment</strong></p>
    </div>
}
else if (isLoading)
{
    <div style="text-align: center; padding: 60px;">
        <div class="spinner" style="width: 40px; height: 40px; border-width: 3px;"></div>
        <p class="mt-4 text-secondary">Generating plan...</p>
    </div>
}
else if (plan != null)
{
    @if (activeTab == "plan")
    {
        <div class="plan-section">
            <h3 style="font-size: 16px; margin-bottom: 16px;">Resources (@plan.ResourcePlans.Count)</h3>
            @foreach (var rp in plan.ResourcePlans)
            {
                <div class="plan-resource">
                    <div class="plan-resource-header">
                        <span class="badge badge-resource">@rp.ResourceType</span>
                        <span style="font-weight: 600; font-size: 15px;">@rp.ResourceKey</span>
                    </div>
                    <div class="plan-resource-body">
                        @foreach (var (key, value) in rp.Configuration)
                        {
                            <div class="plan-config-item">
                                <span class="plan-config-key">@key</span>
                                <span class="plan-config-value">@FormatValue(value)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (activeTab == "resources")
    {
        <div class="card">
            <div class="card-body" style="padding: 0;">
                <table class="resource-table">
                    <thead>
                        <tr>
                            <th>Key</th>
                            <th>Type</th>
                            <th>Provisioner</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rp in plan.ResourcePlans)
                        {
                            <tr>
                                <td style="font-weight: 600;">@rp.ResourceKey</td>
                                <td><span class="badge badge-resource">@rp.ResourceType</span></td>
                                <td>@(plan.Platform.Provisioners.GetValueOrDefault(rp.ResourceType, "—"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (activeTab == "workload")
    {
        <div class="text-muted" style="margin-bottom: 12px;">Namespace <code>@plan.Namespace</code></div>
        @foreach (var workload in plan.Workloads)
        {
            <h3 style="font-size: 16px; margin: 16px 0 8px;">@workload.Name</h3>
            <div class="workload-grid">
                <div class="workload-item">
                    <div class="label">Image</div>
                    <div class="value" style="font-size: 12px;">@(workload.Image ?? "not set")</div>
                </div>
                <div class="workload-item">
                    <div class="label">Replicas</div>
                    <div class="value">@workload.Replicas</div>
                </div>
                <div class="workload-item">
                    <div class="label">CPU</div>
                    <div class="value">@workload.Cpu</div>
                </div>
                <div class="workload-item">
                    <div class="label">Memory</div>
                    <div class="value">@workload.Memory</div>
                </div>
                <div class="workload-item">
                    <div class="label">Secrets</div>
                    <div class="value">@workload.SecretsStrategy</div>
                </div>
            </div>

            @if (workload.EnvironmentVariables.Count > 0)
            {
                <div class="card mt-4">
                    <div class="card-header">
                        <h3>Environment Variables</h3>
                    </div>
                    <div class="card-body">
                        <ul class="env-var-list">
                            @foreach (var (key, value) in workload.EnvironmentVariables)
                            {
                                <li>
                                    <span class="env-var-key">@key</span>
                                    <span class="env-var-value">@(workload.SecretKeys.Contains(key) ? "(secret)" : value)</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        }
    }

    @if (activeTab == "bindings")
    {
        <div class="card">
            <div class="card-body" style="padding: 0;">
                <table class="resource-table">
                    <thead>
                        <tr>
                            <th>Workload</th>
                            <th>Env var</th>
                            <th>Resource</th>
                            <th>Output</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in plan.Bindings)
                        {
                            <tr>
                                <td>@b.Workload</td>
                                <td style="font-family: monospace;">@b.EnvVar</td>
                                <td>@b.ResourceKey <span class="badge badge-resource">@b.ResourceType</span></td>
                                <td>@b.Output @if (b.Sensitive) { <span class="badge badge-warning">sensitive</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public string AppName { get; set; } = "";
    [Parameter] public string Environment { get; set; } = "";

    private DeskribeUiService.AppInfo? appInfo;
    private DeskribePlan? plan;
    private StatusResult? statusResult;
    private string? errorMessage;
    private string? successMessage;
    private List<string> validationErrors = [];
    private List<string> warnings = [];
    private bool isLoading;
    private bool isApplying;
    private bool isDestroying;
    private bool isStatusLoading;
    private string activeTab = "plan";
    private string imagesText = "";
    private bool showApplyConfirm;
    private bool showDestroyConfirm;

    protected override async Task OnParametersSetAsync()
    {
        appInfo = UiService.GetApplications().FirstOrDefault(a => a.Name == AppName);
        plan = null;
        errorMessage = successMessage = null;
        validationErrors = [];
        warnings = [];
        await LoadStatus();
    }

    private void ClearMessages()
    {
        errorMessage = successMessage = null;
        validationErrors = [];
    }

    private async Task LoadStatus()
    {
        if (appInfo == null) return;
        isStatusLoading = true;
        try
        {
            statusResult = await UiService.GetStatusAsync(AppName, Environment);
        }
        finally
        {
            isStatusLoading = false;
        }
    }

    private async Task GeneratePlan()
    {
        isLoading = true;
        ClearMessages();
        plan = null;

        try
        {
            plan = await UiService.PlanAsync(AppName, Environment, DeskribeUiService.ParseImages(imagesText));
            warnings = plan.Warnings;
            successMessage = "Plan generated successfully";
        }
        catch (DeskribeValidationException ex)
        {
            validationErrors = ex.Result.Errors;
            warnings = ex.Result.Warnings;
        }
        catch (Exception ex) when (ex is DeskribeException or AppNotFoundException)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DoApply()
    {
        if (plan == null) return;
        isApplying = true;
        ClearMessages();

        try
        {
            var result = await UiService.ApplyAsync(plan);
            successMessage = $"Applied {AppName} to {Environment} (namespace {result.Namespace}): " +
                             $"{result.Applied.Count} applied, {result.Pruned.Count} pruned.";
        }
        catch (Exception ex) when (ex is DeskribeException or MutationsDisabledException)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            showApplyConfirm = false;
            isApplying = false;
        }
        await LoadStatus();
    }

    private async Task DoDestroy()
    {
        isDestroying = true;
        ClearMessages();

        try
        {
            await UiService.DestroyAsync(AppName, Environment);
            successMessage = $"Destroyed {AppName} in {Environment}.";
            plan = null;
        }
        catch (Exception ex) when (ex is DeskribeException or MutationsDisabledException or AppNotFoundException)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            showDestroyConfirm = false;
            isDestroying = false;
        }
        await LoadStatus();
    }

    private static string GetStatusBadgeClass(AppStatus status) => status switch
    {
        AppStatus.Applied => "badge-healthy",
        AppStatus.Planned => "badge-info",
        AppStatus.Error => "badge-error",
        AppStatus.Destroyed => "badge-warning",
        _ => "badge-muted"
    };

    private static string GetStatusDotClass(AppStatus status) => status switch
    {
        AppStatus.Applied => "healthy",
        AppStatus.Planned => "info",
        AppStatus.Error => "error",
        AppStatus.Destroyed => "warning",
        _ => "muted"
    };

    private static string FormatValue(object? value)
    {
        if (value is null) return "null";
        if (value is JsonElement element) return element.ToString();
        if (value is string s) return s;
        return JsonSerializer.Serialize(value);
    }
}
